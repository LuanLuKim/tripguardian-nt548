.env
.env.*
!.env.example

# Generated CA bundle (system CAs + certs/*.pem), machine-specific
certs/uit-ca-bundle.pem

__pycache__/
.pytest_cache/
*.egg-info/

/data/
.browser/
.superpowers/

osrm-data/

# Run logs and pid files (./run.sh, background crawls)
logs/
*.pid

# Superseded design shots; the current set is docs/design/desktop/v3-rose-photo
docs/design/**/_archive/

# Data bundle made by scripts/pack_data.py, shared outside git
tripguardian-data-*.zip

# Captured real pages (real reviewers, TikTok users): shared in the Drive data zip, not in the public repo
tests/fixtures/gmaps/
tests/fixtures/tiktok/

# model weights fetched by scripts (web/scripts/pick_covers.py)
/.cache/

# Local model experiments and training assets are not part of the application pipeline.
/system_one_model/
/training/

# prod runs from a frozen copy of src (run.sh freeze_src)
/.prod_src*/

# Machine-local state and caches. Symlinks are not matched by a trailing slash, so no slash here.
/.cache
/.cache.old-nfs/
/.venv
/.venv-vllm
/.venv.old-nfs/
/.aws/
/.codex/
/.agents/
/.claude/
/.cursor/
/.impeccable/

# Large local files that must stay out of git (keep git status and the editor fast)
/*.mp4
/Screen Recording*
/inkfilm-out
/Huong-dan-su-dung-server-*.pdf
/frontend_images/
*.safetensors
*.gguf
*.ckpt
*.pth
*.pt
*.npy
*.parquet
scripts/diorama/vendor/node_modules/

# NT548 deploy.sh state (weights, nginx includes, access log)
/ops/nt548/state
