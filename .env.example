# Copy to .env and fill in values. Never commit .env.
# Roles and current models: docs/LLM_PROVIDER.md

# Raw crawl data root (relative to repo root)
DATA_DIR=data

# ASR role: local ChunkFormer on the GPU (Hugging Face id; downloaded on first use)
ASR_MODEL=khanhld/chunkformer-ctc-large-vie
# Second ASR, only for segments the first one got wrong (asr_alt)
ASR_ALT_MODEL=vinai/PhoWhisper-medium

# Extractor role: UIT API (OpenAI-compatible, campus network only)
LLM_API_KEY=
EXTRACTOR_BASE_URL=https://llm.uit.edu.vn/gemma/v1
EXTRACTOR_MODEL=gemma-4-26b
EXTRACTOR_PARALLEL=36  # concurrent calls the endpoint takes: 36 on the UIT key (40 max), 48 on the LAN host

# Judge roles (place qc, dedup, status, audit): the UIT Gemma, 38 calls at once;
# no JUDGE_* endpoint. Audit engine: gemma = the Extractor Gemma, one strict round; empty = the Judge role's model
JUDGE_ENGINE=gemma
# Optional first reader of the audit (a model name on the Judge endpoint); empty = none
JUDGE_FIRST_MODEL=

# TLS: only needed on machines with an old CA store (see docs/LLM_PROVIDER.md)
# SSL_CERT_FILE=certs/uit-ca-bundle.pem
# CURL_CA_BUNDLE=certs/uit-ca-bundle.pem

# UIT API used by Judge and EXTRACTOR_ON_UIT.
UIT_API_KEY=
UIT_API_BASE_URL=https://llm.uit.edu.vn/gemma/v1
UIT_API_MODEL=gemma-4-26b

# Concurrent Extractor calls when the Extractor runs on the UIT key (default 38 of the key's 40).
UIT_EXTRACTOR_PARALLEL=38

# Agent role: live Trip Understanding turns (python -m trip serve).
AGENT_API_KEY=
AGENT_BASE_URL=http://127.0.0.1:20128/v1
AGENT_MODEL=cx/gpt-6.1-sol
AGENT_REASONING_EFFORT=low

# Self-hosted model gateway (scripts/models_ctl.sh, scripts/model_gateway.py on 127.0.0.1:30000): one key for all routes.
MODEL_GATEWAY_API_KEY=
# Self-hosted Gemma behind the gateway, used by Extractor jobs run with EXTRACTOR_ON_SELFHOST=1 / EXTRACTOR_ALSO_SELFHOST=1.
SELFHOST_EXTRACTOR_BASE_URL=http://127.0.0.1:30000/v1
SELFHOST_EXTRACTOR_MODEL=gemma26b-a4b
SELFHOST_EXTRACTOR_PARALLEL=8
# Clef (rule guard of the Judge, src/trip/infrastructure/clef.py). CLEF_BASE_URL on 127.0.0.1:30000 makes ./run.sh prod
# start the self-hosted Clef (SKIP_CLEF=1 skips it); the Judge fails open while Clef is down.
CLEF_BASE_URL=http://127.0.0.1:30000/v1/clef-flash
CLEF_API_KEY=
CLEF_MODEL=clef-flash
CLEF_TIMEOUT_S=2
# Optional second Clef target: Cloudflare Workers AI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLEF_MODEL_ID=@cf/cloudflare/clef-flash

# 9router endpoint for the web image scripts (web/scripts/gen_images.py, gen_tour_mascot.py, ...)
9ROUTER_API_URL=http://localhost:20128/v1
9ROUTER_API_KEY=

# Contact put in the User-Agent of live-context requests. Nominatim's usage policy asks for one.
LIVE_CONTACT=

# Project Postgres: container tripguardian-pg on 127.0.0.1:5433 (./run.sh db creates it, the roles and the schema).
# Superuser password of the container; tg_app writes, tg_analytics only reads (python -m analytics serve).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://tg_app:CHANGE_ME@127.0.0.1:5433/tripguardian
DATABASE_URL_READONLY=postgresql://tg_analytics:CHANGE_ME@127.0.0.1:5433/tripguardian
# Tests marked pg run only with this set (a throwaway schema per test), e.g. the DATABASE_URL above.
# TEST_DATABASE_URL=
# Dev account the QA matrix signs in as (scripts/prod_journey_e2e.py dev_* cases, scripts/local_stack.sh)
DEV_ACCOUNT_EMAIL=
DEV_ACCOUNT_PASSWORD=

# Accounts (docs/ACCOUNTS.md). Public origin of the web app: cookies get Secure on https, mutations must come from it.
APP_BASE_URL=https://tripguardian.visioncare-host.uk
# Google OAuth client (login + Calendar share one callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tripguardian.visioncare-host.uk/api/auth/google/callback
# Fernet key for stored Google refresh tokens: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=
# Web push (docs/COMPANION.md): VAPID key pair (base64url, P-256) and a contact URL or mailto:
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Mail for "Quên mật khẩu" (src/mailer, docs/ACCOUNTS.md §2c). Empty = the link is hidden and the API answers 503.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<gmail>, SMTP_PASSWORD=<App Password>, MAIL_FROM=<gmail>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Dev only (ignored on an https APP_BASE_URL): 1 writes the codes to logs/mail_outbox.jsonl instead of sending
MAIL_DEV_OUTBOX=

# Booking affiliate ids (config/booking.yaml affiliate): left empty until a partner id exists.
BOOKING_VEXERE_AFFILIATE=
BOOKING_TRIPCOM_AFFILIATE=

# Admin Web sign-in (src/analytics/auth.py); empty password = nobody can sign in
ADMIN_EMAIL=admin@tripguardian.local
ADMIN_PASSWORD=
